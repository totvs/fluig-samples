<?xml version="1.0" encoding="UTF-8"?>

<pages>
	<page>
		<code>runner-page</code>
		<enabledChildren>true</enabledChildren>
		<enabledPathParam>false</enabledPathParam>
		<hidden>false</hidden>
		<title>Fluig Runner Page</title>
		<description>Fluig Runner Page</description>
		<theme>themedefault</theme>
		<layout>layoutsimple</layout>
		<editable>true</editable>
		<auth>1</auth>
		<icon>sample-component.png</icon>
		<menuGroup>true</menuGroup>
		<slots>
			<slot>
				<name>SlotA</name>
				<widget>runnerwidget</widget>
			</slot>
		</slots>
		<permissions>
			<permission>
				<code>pageView</code>
				<description>permission.page.view</description>
				<role>user</role>
				<!-- Caso queira colocar um grupo, é só trocar de role para group: <group>grupo-rh</gorup> -->
			</permission>
			<permission>
				<code>pageUpdate</code>
				<description>permission.page.update</description>
				<role>admin</role>
			</permission>
			<permission>
				<code>pageRemove</code>
				<description>permission.page.remove</description>
				<role>admin</role>
			</permission>
		</permissions>		
	</page>
</pages>